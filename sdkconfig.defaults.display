# Waveshare ESP32-S3-Touch-LCD-4.3B build defaults.
# Build with:
#   idf.py -B build-43b -D SDKCONFIG=build-43b/sdkconfig \
#     -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.display" build

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# Keep IRAM headroom for the RGB/LVGL ISR. Wi-Fi IRAM optimisation is not
# necessary for a largely static desk display.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_TIMER_IN_IRAM=n

# The 4.3B uses native USB for the console; UART0 is wired to RS485.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_APP_BOARD_WAVESHARE_43B=y
CONFIG_APP_ENABLE_DISPLAY=y
CONFIG_APP_DISPLAY_BACKEND_LVGL=y
CONFIG_APP_PROVISIONING_SCREEN=y
CONFIG_APP_PROVISIONING_ALLOW_SOFTAP_FALLBACK=y
CONFIG_APP_WIFI_SCAN_MAX=16
CONFIG_APP_DISPLAY_MAX_PAGES=4
CONFIG_APP_DISPLAY_MAX_SCENE_BYTES=16384
CONFIG_APP_DISPLAY_DEFAULT_BRIGHTNESS=70
CONFIG_APP_DISPLAY_TIMEZONE="CST-8"
CONFIG_APP_DISPLAY_NTP_SERVER="pool.ntp.org"
CONFIG_APP_DISPLAY_ALLOW_DO_WRITE=n
CONFIG_APP_DISPLAY_IMAGE_URL_PREFIX=""

# LVGL 9: keep memory in the heap, use the 16px CJK font for the MVP.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=65
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_DEFAULT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_KEYBOARD=y
CONFIG_LV_USE_TEXTAREA=y
CONFIG_LV_USE_BUTTON=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_LIST=y
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_SPINNER=y
CONFIG_LV_USE_CHECKBOX=y
CONFIG_LV_USE_FLEX=y
CONFIG_LV_USE_GRID=y

# No free GPIO header on the 4.3B; GPIO0/48 are LCD data lines.
CONFIG_APP_GPIO_ALLOWLIST=""
CONFIG_APP_GPIO_ALLOW_WRITE=n
CONFIG_APP_LED_GPIO=-1
CONFIG_APP_HOSTNAME_PREFIX="esp32-lcd"
CONFIG_APP_FW_VERSION="0.2.0"

CONFIG_MCP_TOOLLIST_MAX_SIZE=32768
CONFIG_MCP_TOOLCALL_STACK_SIZE=16384
CONFIG_MCP_HTTP_SSE_MAX_CLIENTS=4
CONFIG_MCP_HTTP_SSE_QUEUE_LEN=32
CONFIG_MCP_HTTP_SESSION_TTL_MS=3600000
